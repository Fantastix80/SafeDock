# Binaries
bin/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (only needed if you use folders instead of modules)
vendor/

# Go workspace file
go.work

# IDEs
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment variables / secrets
.env
.env.*
!.env.example

# SafeDock custom build / temp output
dist/
/safedock

# Claude Code local settings (per-developer, not versioned)
.claude/
